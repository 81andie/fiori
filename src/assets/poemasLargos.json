   {
    "id": 14,
    "title": "Un gato en Trastevere...",
    "author": "ANDREA HERNÁNDEZ",
    "verses": [
    "Un gato en Trastevere",
    "me mira con indiferencia",
    "por las calles de Trastevere...",
    "floflo y gordito...",
    "me mira con esos ojos naranjas",
    "pelo atigrado",
    "se estira y se estira",
    "se enrosca en mis piernas",
    "y se va de la misma manera que vino",
    "sigiloso y cauto.",
    "fuerte y audaz da un salto",
    "hacia la ventana",
    "se queda en la repisa",
    "vuelve a saltar",
    "a por más carantoñas..."
    ],

    "background": "hielo.jpg",
    "image": "ungato.png",
    "ilus": "Andrea Hernández/2025"
  },

   {
    "id": 15,
    "title": "Vientos de otoño I...",
    "author": "ANDREA HERNÁNDEZ",
    "verses":  [
      "Vientos de otoño",
      "anuncian un cambio",
      "caen las hojas de los árboles",
      "cómo plumas ligeras de los pájaros",
      "mis pies emiten su crujido",
      "al pisarlas huelo el olor del viento",
      "nevó en Rocacorba",
      "tiñiendo de blanco",
      "sus cumbres",
      "la brisa helada",
      "abanica mi pelo",
      "llegó el frío..."
    ],

    "background": "hielo.jpg",
    "image": "rocacorba.png",
    "ilus": "Andrea Hernández/2025"
  }
