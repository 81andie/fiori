    "title": "SOPLA",
    "author": "ANDREA HERNÁNDEZ",
    "verses": [
      "Bajo un ciprés",
      "la copa en la velada",
      "huelo...",
      "el paladar de la tierra",
      "el perfume de la sal",
      "el pelo se me despiena...",
      "bajo el viento de la Camarga"
    ],
