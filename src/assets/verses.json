    "author": "ANDREA HERNÁNDEZ",
    "verses": [
      "En tu mirada",
      "comprendí",
      "en tus ojos morí",
      "y en tus manos renací"
    ],
    "background": "textura1.jpg",
    "image": "flor5.png",
    "ilus": "AHH"
  },
  {
    "id": 3,
    "title": "La vida no es más",
    "author": "ANDREA HERNÁNDEZ",
    "verses": [
      "La vida no es más que una película",
      "que dura demasiado poco.",
      "Un fotograma de vivencias,",
      "que pasa más deprisa en cuanto,",
      "por infortunios extraños,",
      "vemos peligrar nuestra existencia..."
    ],
    "background": "textura1.jpg",
    "image": "flor2.png",
    "ilus": "AHH"
  },
  {
    "id": 4,
    "title": "El poder del amor",
    "author": "ANDREA HERNÁNDEZ",
    "verses": [
      "El poder del amor",
      "puede llevarte por penurias y espinas,",
      "pero con constancia,",
      "disciplina y amor al prójimo,",
      "todo lo que amas renace,",
      "lleno de esperanza."
    ],
    "background": "papiro.jpg",
    "image": "isis.png",
    "ilus": "AHH"
  },

